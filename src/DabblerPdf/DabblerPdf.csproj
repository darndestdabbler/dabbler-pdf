<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DabblerPdf</RootNamespace>
    <AssemblyName>DabblerPdf</AssemblyName>
    <Description>Text measurement and coordinate-based PDF generation for .NET. Ported from OpenPDF (https://github.com/LibrePDF/OpenPDF).</Description>
    <PackageLicenseExpression>LGPL-2.1-only AND MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/LibrePDF/OpenPDF</PackageProjectUrl>
    <Copyright>Original work Copyright (C) 1999-2024 by Bruno Lowagie and Paulo Soares. C# port Copyright (C) 2026.</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DabblerPdf.Tests" />
  </ItemGroup>

</Project>
